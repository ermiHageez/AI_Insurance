# ==============================================================================
# InsurTech AI Assistant Microservice Configuration
# ==============================================================================

# Server & Environment
PORT=5000
HOST=0.0.0.0
# Options: "test", "development", "production"
APP_ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==============================================================================
# LLM Provider Configuration
# Options:
#   1. "mock"               - Offline deterministic test mock (default for testing)
#   2. "gemini"             - Native Google Gemini API with API Key
#   3. "openai_compatible"  - External Cloud LLM API with API Key (OpenAI, Groq)
#   4. "ollama"             - Local Ollama server
# ==============================================================================
LLM_PROVIDER=mock
LLM_API_KEY=

# --- Option A: Google Gemini API ---
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSyYourGeminiApiKeyHere
# LLM_MODEL=gemini-1.5-flash

# --- Option B: OpenAI API ---
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=sk-...your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# --- Option C: Groq Cloud API ---
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=gsk_...your-groq-key
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option D: Local Ollama ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen2.5:3b

LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1

# Backing Stores
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insuretech_ai
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET_KEY=dev-secret-key-for-local-testing-insureflow-32-chars-min
JWT_ALGORITHM=HS256

# Platform Seam
CLAIM_SERVICE_URL=http://localhost:8080/api/v1/claims
RATE_LIMIT_PER_MINUTE=60
