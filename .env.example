# Server Configuration
PORT=5000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM Provider Configuration
# Options: "ollama", "openai_compatible", "mock"
LLM_PROVIDER=mock
# Optional API Key for external LLM provider (OpenAI, Gemini, Groq, etc.)
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0.1

# Backing Stores (Optional for full containerized run)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insuretech_ai
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET_KEY=dev-secret-key-for-local-testing-insureflow-32-chars-min
JWT_ALGORITHM=HS256

# Claim Service URL (Platform seam)
CLAIM_SERVICE_URL=http://localhost:8080/api/v1/claims

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
